        "type": "function",
        "z": "bbb63b633bccef83",
        "name": "Route",
        "func": "var d = msg.payload;\nvar dist = d.dist || 0;\nif (dist > 100) dist = 100;  // 999=測不到/超出範圍 → 鎖在量表上限，避免爆表\nreturn [\n  {payload: d},\n  {payload: dist},\n  {payload: '角度 ' + (d.angle||0) + '°　模式 ' + (d.mode||'--')}\n];",
        "outputs": 3,
        "x": 420,
        "y": 120,
