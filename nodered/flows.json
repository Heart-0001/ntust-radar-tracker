    {
        "id": "n_canvas",
        "type": "ui_template",
        "z": "bbb63b633bccef83",
        "group": "grp1",
        "name": "雷達",
        "order": 1,
        "width": "12",
        "height": "10",
        "format": "<canvas id=\"rc\" width=\"580\" height=\"280\" style=\"background:#001a00;display:block;margin:auto\"></canvas>\n<script>\n(function(){\n  var cv,ctx,cx,cy,R,pts=[],MAX=100,FADE=3000;\n  function setup(){\n    cv=document.getElementById('rc');\n    if(!cv)return;\n    ctx=cv.getContext('2d');\n    cx=cv.width/2;cy=cv.height-10;R=cy-10;\n  }\n  function draw(ang,dist,det){\n    if(!ctx){setup();if(!ctx)return;}\n    var now=Date.now();\n    if(det&&dist<MAX)pts.push({a:ang,d:dist,t:now});\n    pts=pts.filter(function(p){return now-p.t<FADE;});\n    ctx.fillStyle='#001a00';ctx.fillRect(0,0,cv.width,cv.height);\n    ctx.strokeStyle='#003300';ctx.lineWidth=1;\n    for(var i=1;i<=4;i++){ctx.beginPath();ctx.arc(cx,cy,R*i/4,Math.PI,2*Math.PI);ctx.stroke();}\n    for(var a=0;a<=180;a+=30){var r=a*Math.PI/180;ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+R*Math.cos(r),cy-R*Math.sin(r));ctx.stroke();}\n    var sr=ang*Math.PI/180;\n    ctx.strokeStyle='rgba(0,255,0,0.8)';ctx.lineWidth=2;\n    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+R*Math.cos(sr),cy-R*Math.sin(sr));ctx.stroke();\n    pts.forEach(function(p){\n      var al=1-(now-p.t)/FADE;\n      var dp=p.d/MAX*R;\n      var pr=p.a*Math.PI/180;\n      ctx.fillStyle='rgba(0,255,0,'+al+')';\n      ctx.beginPath();ctx.arc(cx+dp*Math.cos(pr),cy-dp*Math.sin(pr),5,0,2*Math.PI);ctx.fill();\n    });\n  }\n  scope.$watch('msg',function(msg){\n    if(msg&&msg.payload)draw(msg.payload.angle||90,msg.payload.dist||999,!!msg.payload.detected);\n  });\n  setup();\n})();\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 620,
        "y": 60,
        "wires": [
            []
        ]
    },
